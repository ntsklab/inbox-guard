# =========================================
# inbox-guard — ActivityPub inbox spam filter
# (Kubernetes deployment)
# =========================================
#
# Deploy this alongside your ActivityPub server.
# Replace NAMESPACE placeholder.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: inbox-guard
  namespace: <NAMESPACE>
  labels:
    app: inbox-guard
    role: spam-filter
spec:
  replicas: 1
  selector:
    matchLabels:
      app: inbox-guard
      role: spam-filter
  template:
    metadata:
      labels:
        app: inbox-guard
        role: spam-filter
    spec:
      containers:
        - name: inbox-guard
          image: ghcr.io/ntsklab/inbox-guard:latest
          env:
            # Target backend (your ActivityPub server)
            - name: BACKEND
              value: "http://your-ap-server.<NAMESPACE>.svc.cluster.local:3000"
            # Action: HTTP status code to return when blocking ("403" = reject, "200" = silent drop)
            - name: ACTION
              value: "403"
            # Max mentions before blocking (default: 4)
            - name: MAX_MENTIONS
              value: "4"
            # Max content ratio: if mentions occupy more than this share of
            # content, block. Requires at least 2 mentions; "1.0" disables.
            - name: MAX_CONTENT_RATIO
              value: "0.9"
            # Comma-separated keywords/URLs to block
            - name: BLOCK_KEYWORDS
              value: ""
            # Comma-separated domains to block
            - name: BLOCK_DOMAINS
              value: ""
            # Our instance domain (required for MENTION_FILTER_TARGET other than "always")
            - name: LOCAL_DOMAIN
              value: ""
            # When to enforce the mention filter: always | mentioned | in_reply_to | mentioned_or_in_reply_to
            - name: MENTION_FILTER_TARGET
              value: "always"
            - name: LOG_LEVEL
              value: "info"
            - name: LISTEN_PORT
              value: "3000"
            # Port for /metrics (separate from the public inbox endpoint; do not expose externally)
            - name: METRICS_PORT
              value: "9090"
          resources:
            limits:
              cpu: "200m"
              memory: "32Mi"
            requests:
              cpu: "50m"
              memory: "16Mi"
          ports:
            - containerPort: 3000
            - containerPort: 9090
          startupProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 2
            periodSeconds: 2
            failureThreshold: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 2
            periodSeconds: 5
            failureThreshold: 3
---
apiVersion: v1
kind: Service
metadata:
  name: inbox-guard
  namespace: <NAMESPACE>
spec:
  type: ClusterIP
  selector:
    app: inbox-guard
    role: spam-filter
  ports:
    - name: http
      protocol: TCP
      port: 3000
      targetPort: 3000
    - name: metrics
      protocol: TCP
      port: 9090
      targetPort: 9090
